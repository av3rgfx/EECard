{
  "name": "eecard-design-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "preview:portable": "npm run build && node scripts/portable-preview.mjs",
    "format": "prettier --write src tests scripts *.ts *.json",
    "format:check": "prettier --check src tests scripts *.ts *.json",
    "preview:shareable": "npm run preview:portable && node scripts/build-shareable-previews.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
